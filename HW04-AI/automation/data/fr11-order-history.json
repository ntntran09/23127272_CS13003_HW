  {
    "id": "FR11-AUTO-011",
    "title": "Canceled order cannot be canceled again",
    "action": "final-no-cancel",
    "input": { "orders": [{ "id": 109, "user_id": 2, "total_amount": 100, "status": "canceled", "created_at": "2026-08-08T10:30:00Z" }], "label": "Đã hủy" },
