{
  "name": "eshop-hw04-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Data-driven Playwright automation for EShop FR-03, FR-11, and FR-14",
  "scripts": {
    "test": "playwright test",
    "test:fr03": "playwright test tests/fr03-password-reset.spec.js",
    "test:fr11": "playwright test tests/fr11-order-history.spec.js",
    "test:fr14": "playwright test tests/fr14-category-management.spec.js",
    "test:matrix": "node scripts/run-browser-matrix.js",
    "demo": "node scripts/run-demo.js",
    "demo:fr03": "node scripts/run-demo.js --feature fr03",
    "demo:fr11": "node scripts/run-demo.js --feature fr11",
    "demo:fr14": "node scripts/run-demo.js --feature fr14",
    "validate:data": "node scripts/validate-test-data.js",
    "validate:data:skill": "node ../skills/convert-domain-cases-to-playwright/scripts/validate-case-data.js data/fr03-password-reset.json data/fr11-order-history.json data/fr14-category-management.json",
    "validate:reports": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/validate-reports.ps1",
    "validate:reports:skill": "node ../skills/run-playwright-browser-matrix/scripts/verify-reports.js --root . --runner-id 23127272 --browsers chromium,firefox,webkit,chrome,edge --features fr03,fr11,fr14 --summary reports/run-summary.json"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2"
  }
}
